# Copy to .env and fill in. docker compose reads .env automatically; .gitignore keeps it out of git.
# Every value below is the default from compose.yaml unless marked otherwise.

# ── Spotify (gaida-spotify) ────────────────────────────────────────────────────
# No credentials: the pod runs on SpotAPI, which needs no client ID and no secret.
# Search hits per query. Each one costs Gaida.API a lookup against the library or YouTube.
SPOTIFY_SEARCH_LIMIT=15

# ── The library (gaida-local) ──────────────────────────────────────────────────
# Mounted read-write: Info.json is rewritten in place.
MUSIC_LIBRARY_PATH=./data/music
ALBUM_COVERS_PATH=./data/covers
# Needs the scheme — it becomes an absolute cover URL.
PUBLIC_DOMAIN=http://localhost

# ── YouTube caches (gaida-youtube) ─────────────────────────────────────────────
# Repointing the audio cache starts empty and re-downloads everything.
YOUTUBE_CACHE_DB_PATH=./data/youtube-cache
YOUTUBE_AUDIO_CACHE_PATH=./data/youtube-audio

# ── Gaida.API ──────────────────────────────────────────────────────────────────
# Absolute and public: every contentUrl is built from it.
PUBLIC_API_BASE_URL=http://localhost:5340
YOUTUBE_RANDOM_SHARE=0.4
RESOLVE_CONCURRENCY=4

# ── Dunav ──────────────────────────────────────────────────────────────────────
DUNAV_RETENTION_MINUTES=45
# Disk budget, sized against free space on /.
DUNAV_MAX_BYTES=21474836480
DUNAV_MEMORY_LIMIT=1g

# ── Host ports ─────────────────────────────────────────────────────────────────
# Bound to 127.0.0.1; nginx faces the world.
GAIDA_API_PORT=5340
DUNAV_PORT=5341
SELO_PORT=5342
DOM_PORT=5343

# ── Admin panel (oko) ──────────────────────────────────────────────────────────
# Oko refuses to start while either is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# How Oko proves itself to every service's /Admin routes. Generate one:
#   openssl rand -hex 32
# Unset, /Admin is disabled everywhere and Oko shows every target as down.
ADMIN_TOKEN=
# Published on every interface, unlike the ports above — the host firewall gates it.
# Basic auth sends its password unencrypted, so front it with TLS on an untrusted network.
OKO_PORT=5344
